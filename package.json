{
  "name": "davecoin",
  "version": "1.0.0",
  "private": true,
  "description": "DaveCoin (DAVE) — SPL token on Solana",
  "workspaces": [
    "token",
    "web"
  ],
  "scripts": {
    "token:create": "npm run create --workspace=token",
    "token:airdrop": "npm run airdrop --workspace=token",
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "bigint-buffer@1.1.5": true
  }
}
